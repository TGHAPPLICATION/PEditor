{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "peditor/tests/fixtures/manifest.schema.json",
  "title": "PEditor fixture manifest row（spec §5）",
  "description": "manifest.csv 每一列（csv.DictReader 讀成字串字典）須符合本 schema。座標慣例：PyMuPDF 頁面座標，即未旋轉頁面空間、以 CropBox 左上角為原點、y 向下、單位 pt（CropBox 非零原點時與 PDF user space 有位移，如 L01）；格式 x0,y0,x1,y1。",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_id", "group", "sha256", "generator", "generator_version", "fonts", "expected",
               "reason_code", "page_index", "target", "bbox_pt", "original_text", "new_text",
               "editable_region_pt", "protected_region", "blind", "storage", "status", "notes"],
  "properties": {
    "fixture_id": {"type": "string", "pattern": "^[TFLIBUS][0-9]{2}$", "description": "群組字母 + 序號（spec §5）"},
    "group": {"enum": ["T 基礎文字", "F 字型與編碼", "L 幾何與背景", "I 圖片", "B 表格", "U 特殊文件", "S 損毀與惡意"]},
    "sha256": {"type": "string", "pattern": "^([0-9a-f]{64})?$"},
    "generator": {"enum": ["pymupdf", "reportlab", "pymupdf+pikepdf", "word", "libreoffice", "other", "script-p7"]},
    "generator_version": {"type": "string"},
    "fonts": {"type": "string"},
    "expected": {"enum": ["support", "reject", "readonly"], "description": "精確可編輯清單於 P2 前鎖定（spec §5）"},
    "reason_code": {
      "enum": ["", "UNSUPPORTED_ENCODING", "UNSUPPORTED_LAYOUT", "GLYPH_MISSING", "TEXT_OVERFLOW",
               "SHARED_RESOURCE_UNSAFE", "SIGNED_DOCUMENT", "ENCRYPTED_DOCUMENT", "RESOURCE_LIMIT",
               "NO_TEXT_LAYER", "MALFORMED_DOCUMENT", "ACTIVE_CONTENT", "UNSUPPORTED_FEATURE"],
      "description": "spec §7 錯誤碼；後四個為 ADR-0007 提議補充"
    },
    "page_index": {"type": "string", "pattern": "^([0-9]+)?$"},
    "target": {"type": "string", "pattern": "^(|text|image#[0-9]+|cell\\([0-9]+,[0-9]+\\))$"},
    "bbox_pt": {"type": "string", "pattern": "^(|-?[0-9.]+,-?[0-9.]+,-?[0-9.]+,-?[0-9.]+)$"},
    "original_text": {"type": "string"},
    "new_text": {"type": "string"},
    "editable_region_pt": {"type": "string", "pattern": "^(|-?[0-9.]+,-?[0-9.]+,-?[0-9.]+,-?[0-9.]+)$"},
    "protected_region": {"type": "string"},
    "blind": {"enum": ["true", "false"]},
    "storage": {"enum": ["repo", "offline"], "description": "repo=tests/fixtures/files/<id>.pdf；offline=人工保管不進 repo"},
    "status": {"enum": ["available", "pending"]},
    "notes": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"blind": {"const": "true"}}}, "then": {"properties": {"storage": {"const": "offline"}}}},
    {"if": {"properties": {"expected": {"const": "support"}}},
     "then": {"properties": {"reason_code": {"const": ""}}},
     "else": {"properties": {"reason_code": {"minLength": 1}}}},
    {"if": {"properties": {"status": {"const": "available"}}},
     "then": {"properties": {"sha256": {"minLength": 64}, "generator_version": {"minLength": 1}}}}
  ]
}
