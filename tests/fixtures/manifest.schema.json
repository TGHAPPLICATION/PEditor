{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "peditor/tests/fixtures/manifest.schema.json",
  "title": "PEditor fixture manifest row",
  "description": "manifest.csv 每一列（以 csv.DictReader 讀成字串字典）須符合本 schema。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "group", "source", "generator", "expected", "reason", "phase", "blind", "storage", "status", "notes"],
  "properties": {
    "id": {"type": "string", "pattern": "^(S|H|B)[0-9]{2}$", "description": "S=合成、H=人工產生、B=盲測"},
    "group": {
      "enum": ["latin", "cjk", "mixed", "layout", "table", "occurrence", "perf",
               "reject-no-text", "reject-encrypted", "reject-broken", "reject-unsupported"]
    },
    "source": {"enum": ["synthetic-pymupdf", "word", "libreoffice", "other"]},
    "generator": {"type": "string", "pattern": "^([a-z0-9_]+)?$", "description": "scripts/gen_fixtures.py 中的函式名；非合成時留空"},
    "expected": {"enum": ["support", "reject"]},
    "reason": {
      "enum": ["", "font_not_embedded", "no_text_layer", "encrypted", "malformed", "not_pdf",
               "form_fields", "invisible_text", "signed"]
    },
    "phase": {"enum": ["P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8"], "description": "第一個使用此樣本的關卡"},
    "blind": {"enum": ["true", "false"]},
    "storage": {"enum": ["generated", "repo", "offline"], "description": "generated=CI 現場產生；repo=提交於 tests/fixtures/files；offline=人工保管不進 repo"},
    "status": {"enum": ["available", "pending"]},
    "notes": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"source": {"const": "synthetic-pymupdf"}}},
     "then": {"properties": {"generator": {"minLength": 1}, "storage": {"const": "generated"}}}},
    {"if": {"properties": {"blind": {"const": "true"}}},
     "then": {"properties": {"storage": {"const": "offline"}}}},
    {"if": {"properties": {"expected": {"const": "reject"}}},
     "then": {"properties": {"reason": {"minLength": 1}}},
     "else": {"properties": {"reason": {"const": ""}}}}
  ]
}
